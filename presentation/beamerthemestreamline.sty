\mode<presentation>

% Requirement
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{graphicx}

% Settings
\useinnertheme{streamline}
\useoutertheme{streamline}
\usecolortheme{streamline}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{blocks}[rounded][shadow=true]

% Colour definitions
\definecolor{streamlinegray}{HTML}{e9edee}
\definecolor{streamlinegreen}{HTML}{1a9988}
\definecolor{streamlineorange}{HTML}{eb5600}
\definecolor{streamlineblue}{HTML}{6aa4c8}
\definecolor{streamlinetextgray}{HTML}{595959}

% Theme constants
\newcommand{\headeryoffsetratio}{0.9048}
\newcommand{\delimyoffsetratio}{0.7593}
\newcommand{\delimxoffsetratio}{0.0909}
\newcommand{\delimlengthratio}{0.0406}
\newcommand{\delimheightratio}{0.0091}

\newcommand{\headerleftoffsetratio}{0.0850}
\newcommand{\headerrightoffsetratio}{0.0795}
\newcommand{\headertopoffsetratio}{0.2000}

\mode<all>