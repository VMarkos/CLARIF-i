\mode<presentation>

% Colours
\setbeamercolor*{title page header}{fg=black}
\setbeamercolor*{subtitle}{fg=streamlinetextgray}
\setbeamercolor*{author}{fg=streamlinetextgray}
\setbeamercolor*{date}{fg=streamlinetextgray}
\setbeamercolor*{page number}{fg=streamlinetextgray}
\setbeamercolor*{frametitle}{fg=black}
\setbeamercolor*{normal text}{fg=streamlinetextgray}
\setbeamercolor*{item}{fg=streamlinetextgray}
\setbeamercolor*{section name}{fg=white}
\setbeamercolor*{section in toc}{fg=streamlinetextgray}
\setbeamercolor*{subsection in toc}{fg=streamlinetextgray}

% Fonts
\setbeamerfont*{normal text}{size=\small}
\setbeamerfont*{itemize/enumerate subbody}{size=\footnotesize}

% Items
\setbeamertemplate{items}[circle]
\setbeamertemplate{sections/subsections in toc}[circle]

\mode
<all>
